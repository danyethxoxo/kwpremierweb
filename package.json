{
  "name": "kwpremierweb",
  "private": true,
  "scripts": {
    "test": "node --test --test-timeout=120000 tests/*.test.mjs",
    "test:edge": "deno test --allow-env --allow-read tests/security-edge.test.ts tests/mfa-policy.test.ts",
    "check:edge": "deno check supabase/functions/*/index.ts",
    "security:scan": "node herramientas/scan-secrets.mjs",
    "migration:check": "node herramientas/verificar-migraciones.mjs",
    "release:check": "npm run security:scan && npm run migration:check && npm test && npm run check:edge && npm run test:edge && npm audit --audit-level=high",
    "production:check": "node herramientas/verificar-produccion.mjs",
    "audit:ui": "node herramientas/auditar-sitio.mjs",
    "audit:public": "node herramientas/auditar-publico.mjs",
    "vendor:pdf": "node herramientas/preparar-pdf.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.13.6",
    "deno": "2.9.6",
    "fake-indexeddb": "6.2.5",
    "jspdf": "4.2.1",
    "playwright": "1.63.0",
    "sharp": "0.35.5"
  }
}
