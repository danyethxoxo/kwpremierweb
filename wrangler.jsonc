{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kweb",
  "main": "deployment/kweb-worker.mjs",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".kweb-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
