# Documentation only. Copy to an ignored .env file and configure Supabase secrets.
# Never import this file into HTML or publish it as a static asset.
ALLOWED_ORIGINS=https://www.kwpremieroficial.com,https://kwpremieroficial.com
DATA_GATEWAY_SECRET=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# Existing deployments may also use SERVICE_ROLE_KEY.
SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CORREO_REMITENTE=
CORREO_COPIA=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REFRESH_TOKEN_CONTACTOS=
GOOGLE_REFRESH_TOKEN_KWPREMIER=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SALAS_ID=
ALTA_SHEET_ID=
ALTA_SHEET_RANGO=A1:Z500
ALTA_DRIVE_FOLDER_ID=
ALTA_EMAILS=
WEETRUST_USER_ID=
WEETRUST_API_KEY=
WEETRUST_AMBIENTE=produccion
WEETRUST_WEBHOOK_SECRET=
WEBHOOK_SECRET=
SYNC_SECRET=
FEED_URL=
FEED_USER=
FEED_PASS=
# Gateway ingress must overwrite this header or append the actual connecting peer.
TRUSTED_IP_HEADER=x-forwarded-for
ALLOW_LOCAL_HTTP=false
